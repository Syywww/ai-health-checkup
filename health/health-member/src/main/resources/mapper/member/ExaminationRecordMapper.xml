<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.member.mapper.ExaminationRecordMapper">

    <resultMap type="com.health.member.domain.ExaminationRecord" id="RecordResult">
        <id property="id" column="id"/>
        <result property="memberId" column="member_id"/>
        <result property="setmealId" column="setmeal_id"/>
        <result property="examinationDate" column="examination_date"/>
        <result property="doctor" column="doctor"/>
        <result property="resultSummary" column="result_summary"/>
        <result property="status" column="status"/>
        <result property="attachment" column="attachment"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <!-- 关联查询 -->
        <result property="memberName" column="member_name"/>
        <result property="setmealName" column="setmeal_name"/>
    </resultMap>

    <sql id="selectRecordVo">
        select r.*, m.name as member_name, s.name as setmeal_name
        from examination_record r
                 left join member m on r.member_id = m.id
                 left join t_setmeal s on r.setmeal_id = s.id
    </sql>

    <select id="selectRecordList" parameterType="ExaminationRecord" resultMap="RecordResult">
        <include refid="selectRecordVo"/>
        <where>
            <if test="memberId != null and memberId != ''">and r.member_id = #{memberId}</if>
            <if test="setmealId != null and setmealId != ''">and r.setmeal_id = #{setmealId}</if>
            <if test="examinationDate != null">and r.examination_date = #{examinationDate}</if>
            <if test="status != null and status != ''">and r.status = #{status}</if>
        </where>
        order by r.create_time desc
    </select>

    <select id="selectRecordById" parameterType="Long" resultMap="RecordResult">
        <include refid="selectRecordVo"/> where r.id = #{id}
    </select>

    <insert id="insertRecord" parameterType="ExaminationRecord" useGeneratedKeys="true" keyProperty="id">
        insert into examination_record (
        <if test="memberId != null">member_id,</if>
        <if test="setmealId != null">setmeal_id,</if>
        <if test="examinationDate != null">examination_date,</if>
        <if test="doctor != null and doctor != ''">doctor,</if>
        <if test="resultSummary != null and resultSummary != ''">result_summary,</if>
        <if test="status != null and status != ''">status,</if>
        <if test="attachment != null and attachment != ''">attachment,</if>
        <if test="remark != null and remark != ''">remark,</if>
        create_by, create_time
        ) values (
        <if test="memberId != null">#{memberId},</if>
        <if test="setmealId != null">#{setmealId},</if>
        <if test="examinationDate != null">#{examinationDate},</if>
        <if test="doctor != null and doctor != ''">#{doctor},</if>
        <if test="resultSummary != null and resultSummary != ''">#{resultSummary},</if>
        <if test="status != null and status != ''">#{status},</if>
        <if test="attachment != null and attachment != ''">#{attachment},</if>
        <if test="remark != null and remark != ''">#{remark},</if>
        #{createBy}, sysdate()
        )
    </insert>

    <update id="updateRecord" parameterType="ExaminationRecord">
        update examination_record
        <set>
            <if test="memberId != null">member_id = #{memberId},</if>
            <if test="setmealId != null">setmeal_id = #{setmealId},</if>
            <if test="examinationDate != null">examination_date = #{examinationDate},</if>
            <if test="doctor != null and doctor != ''">doctor = #{doctor},</if>
            <if test="resultSummary != null and resultSummary != ''">result_summary = #{resultSummary},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="attachment != null and attachment != ''">attachment = #{attachment},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            update_by = #{updateBy}, update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteRecordById" parameterType="Long">
        delete from examination_record where id = #{id}
    </delete>

    <delete id="deleteRecordByIds" parameterType="Long">
        delete from examination_record where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="countRecordByDate" resultType="int">
        select count(*) from examination_record
        <where>
            <if test="startDate != null and startDate != ''">and date_format(examination_date,'%Y-%m-%d') &gt;= #{startDate}</if>
            <if test="endDate != null and endDate != ''">and date_format(examination_date,'%Y-%m-%d') &lt;= #{endDate}</if>
        </where>
    </select>

</mapper>