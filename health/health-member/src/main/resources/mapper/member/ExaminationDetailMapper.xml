<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.health.member.mapper.ExaminationDetailMapper">

    <resultMap type="com.health.member.domain.ExaminationDetail" id="DetailResult">
        <id property="id" column="id"/>
        <result property="recordId" column="record_id"/>
        <result property="checkitemId" column="checkitem_id"/>
        <result property="resultValue" column="result_value"/>
        <result property="unit" column="unit"/>
        <result property="referenceRange" column="reference_range"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="checkitemName" column="checkitem_name"/>
    </resultMap>

    <sql id="selectDetailVo">
        select d.*, c.name as checkitem_name
        from examination_detail d
                 left join t_checkitem c on d.checkitem_id = c.id
    </sql>

    <select id="selectDetailList" parameterType="ExaminationDetail" resultMap="DetailResult">
        <include refid="selectDetailVo"/>
        <where>
            <if test="recordId != null">and d.record_id = #{recordId}</if>
            <if test="checkitemId != null">and d.checkitem_id = #{checkitemId}</if>
            <if test="status != null and status != ''">and d.status = #{status}</if>
        </where>
    </select>

    <select id="selectDetailById" parameterType="Long" resultMap="DetailResult">
        <include refid="selectDetailVo"/> where d.id = #{id}
    </select>

    <insert id="insertDetail" parameterType="ExaminationDetail" useGeneratedKeys="true" keyProperty="id">
        insert into examination_detail (
            record_id, checkitem_id, result_value, unit, reference_range, status, create_by, create_time
        ) values (
                     #{recordId}, #{checkitemId}, #{resultValue}, #{unit}, #{referenceRange}, #{status}, #{createBy}, sysdate()
                 )
    </insert>

    <insert id="batchInsertDetails" parameterType="list">
        insert into examination_detail (record_id, checkitem_id, result_value, unit, reference_range, status, create_by, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.recordId}, #{item.checkitemId}, #{item.resultValue}, #{item.unit}, #{item.referenceRange}, #{item.status}, #{item.createBy}, sysdate())
        </foreach>
    </insert>

    <update id="updateDetail" parameterType="ExaminationDetail">
        update examination_detail
        <set>
            <if test="resultValue != null">result_value = #{resultValue},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="referenceRange != null">reference_range = #{referenceRange},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            update_by = #{updateBy}, update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteDetailByRecordId" parameterType="Long">
        delete from examination_detail where record_id = #{recordId}
    </delete>

    <delete id="deleteDetailById" parameterType="Long">
        delete from examination_detail where id = #{id}
    </delete>

</mapper>